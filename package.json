{
  "name": "horse-racing-game",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive horse racing game built with Vue 3, TypeScript and Pinia.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "type-check": "vue-tsc --build && tsc -p e2e/tsconfig.json",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:eslint": "eslint . --cache --max-warnings 0",
    "lint:fix": "oxlint . --fix && eslint . --cache --fix",
    "format": "prettier --write src/ e2e/",
    "format:check": "prettier --check src/ e2e/",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:docker": "sh scripts/visual-tests-in-docker.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --fix --deny-warnings",
      "eslint --cache --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md,html,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
